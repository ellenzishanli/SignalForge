# ============================================================
# Frontier Tech Radar — Environment Configuration
# ============================================================

# ── LLM Provider (pick one) ──────────────────────────────────
# Options: groq (free) | ollama (local) | anthropic (paid) | gemini (free tier)
LLM_PROVIDER=groq

# ── Groq (FREE — recommended) ────────────────────────────────
# Sign up free at: https://console.groq.com
# Free tier: ~14,400 requests/day, very fast
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (FREE tier) ────────────────────────────────
# Sign up free at: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/min, 1M tokens/day
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Ollama (100% LOCAL — no API key needed) ──────────────────
# Install: https://ollama.com  then: ollama pull llama3
# OLLAMA_MODEL=llama3
# OLLAMA_URL=http://localhost:11434

# ── Anthropic Claude (paid) ───────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Reddit API (optional — improves Reddit data quality) ─────
# Get free credentials at: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
